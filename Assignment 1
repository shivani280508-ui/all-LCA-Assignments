# 9. Suppose a date is represented as a tuple (d,m,y).
# Create two date tuples and find the number of days between two dates.

from datetime import date

d1 = tuple(map(int, input("Enter first date (d m y): ").split()))
d2 = tuple(map(int, input("Enter second date (d m y): ").split()))

date1 = date(d1[2], d1[1], d1[0])
date2 = date(d2[2], d2[1], d2[0])

days = abs((date2 - date1).days)

print("Number of days:", days)
