# 7. Calculate frequency of letters occurring in a given string

text = input("Enter a string: ")

freq = {}

for ch in text:
    if ch in freq:
        freq[ch] = freq[ch] + 1
    else:
        freq[ch] = 1

print(freq)


# 8. Write a program which takes numerator and denominator values from the user
